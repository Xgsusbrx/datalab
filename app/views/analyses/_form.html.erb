<%= form_with model: @analysis, html: { multipart: true } do |form| %>

  <%= form.label :column_name, "¿Qué columna querés trabajar?" %>
  <%= form.text_field :column_name %>

  <%= form.label :operacion, "Selecciona una operación:" %>
  <%= form.select :operation, ["sum", "average", "max", "min"] %>

  <%= form.file_field :csv %>

  <%= form.submit "Procesar el CSV" %>

<% end %>