<h2>el resultado de tu operacion es: </h2>


<% if @analysis.status == "failed" %>
  <p> Error: <%= @analysis.error_message %></p>

<% elsif @analysis.status == "completed" %>  

  <p>Resultado: <%= @analysis.Result %></p>

<% else %>
  <p> Procesando . . . </p>

<% end %>

<p>
  <%= @analysis.operation.capitalize %>: <%= @result %>
 </p>

 <p>La columna que se trabajo fue: <%=@analysis.column_name %> 





